{
  "expo": {
    "name": "Kalyanam Travel",
    "slug": "mobile-app",
    "scheme": "kalyanamtravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf8f4",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.shreekalyanam.travel",
      "adaptiveIcon": {
        "backgroundColor": "#faf8f4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f05cc5d-c725-4c01-a340-268b75313bec"
      }
    },
    "owner": "shrikalyanam"
  }
}
