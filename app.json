{
  "expo": {
    "name": "Kalyanam Travel",
    "slug": "shrikalyanam",
    "scheme": "kalyanamtravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf8f4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shreekalyanam.travel"
    },
    "android": {
      "package": "com.shreekalyanam.travel",
      "adaptiveIcon": {
        "backgroundColor": "#faf8f4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 230,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f4",
          "dark": {
            "backgroundColor": "#faf8f4"
          }
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f6e9246-5a38-441c-be94-88355e1c4bc7"
      }
    },
    "owner": "shrikalyanams-team"
  }
}
